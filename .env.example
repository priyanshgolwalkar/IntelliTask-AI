# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=""
GEMINI_REQUEST_TIMEOUT_MS="30000"
GEMINI_RETRY_ATTEMPTS="2"

# Groq fallback provider
GROQ_API_KEY=""
GROQ_MODEL=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Shared provider priority and request settings
LLM_PROVIDER_PRIORITY="gemini,groq"
LLM_REQUEST_TIMEOUT_MS="30000"
LLM_RETRY_ATTEMPTS="2"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (auto-loaded from firebase-applet-config.json, with optional env overrides)
VITE_FIREBASE_API_KEY="AIzaSy..."
VITE_FIREBASE_AUTH_DOMAIN="sustained-splicer-pcbh2.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sustained-splicer-pcbh2"
VITE_FIREBASE_STORAGE_BUCKET="sustained-splicer-pcbh2.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="288521086899"
