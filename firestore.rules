rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'fullName', 'email', 'createdAt', 'updatedAt', 'emailVerified', 'preferences', 'photoURL']) &&
        data.uid is string && data.uid == request.auth.uid &&
        data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 120 &&
        data.email is string && data.email.size() <= 160 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'status', 'priority', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'description', 'status', 'priority', 'assignedAgent', 'tags', 'createdAt', 'dueDate', 'estimatedHours', 'subtasks', 'source', 'langGraphNodeId']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.status is string && data.status in ['todo', 'in_progress', 'in_review', 'completed', 'blocked'] &&
        data.priority is string && data.priority in ['low', 'medium', 'high', 'urgent'] &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'content', 'timestamp']) &&
        data.keys().hasOnly(['id', 'userId', 'role', 'content', 'timestamp', 'status']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.role is string && data.role in ['user', 'assistant'] &&
        data.content is string && data.content.size() <= 10000 &&
        data.timestamp is string && data.timestamp.size() <= 40;
    }

    function isValidAgentLog(data) {
      return data.keys().hasAll(['id', 'userId', 'agentId', 'agentName', 'action', 'timestamp']) &&
        data.keys().hasOnly(['id', 'userId', 'agentId', 'agentName', 'action', 'decision', 'status', 'timestamp', 'toolName', 'toolInput', 'toolOutput', 'details']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.agentId is string && data.agentId.size() <= 64 &&
        data.agentName is string && data.agentName.size() <= 100 &&
        data.action is string && data.action.size() <= 200 &&
        data.timestamp is string && data.timestamp.size() <= 40;
    }

    function isValidAgentMemory(data) {
      return data.keys().hasAll(['id', 'userId', 'agentId', 'category', 'content', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'agentId', 'category', 'content', 'updatedAt', 'metadata']) &&
        data.id is string && data.id.size() <= 64 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.agentId is string && data.agentId.size() <= 64 &&
        data.category is string && data.category.size() <= 100 &&
        data.content is string && data.content.size() <= 2000 &&
        data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if isOwner(userId);

      // User isolated task collection
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming());
        allow update: if isOwner(userId) && isValidId(taskId) && isValidTask(incoming()) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // User isolated conversation messages
      match /conversations/{messageId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(messageId) && isValidMessage(incoming());
        allow update: if isOwner(userId) && isValidId(messageId) && isValidMessage(incoming()) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(messageId);
      }

      // User isolated agent execution logs
      match /agent_logs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidAgentLog(incoming());
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // User isolated agent memory
      match /agent_memory/{memoryId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(memoryId) && isValidAgentMemory(incoming());
        allow update: if isOwner(userId) && isValidId(memoryId) && isValidAgentMemory(incoming()) &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(memoryId);
      }
    }
  }
}
